{
  "name": "pets",
  "productName": "Pets",
  "version": "0.1.0",
  "private": true,
  "description": "Pets - kleine Bildschirm-Begleiter, die sich mit NEXUS, DAN, Nook oder jeder anderen App verbinden",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "electron . --smoke",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "io.github.caseymazey.pets",
    "productName": "Pets",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png", "artifactName": "Pets-Setup-${version}.${ext}" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": "always", "createStartMenuShortcut": true, "shortcutName": "Pets", "runAfterFinish": true }
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  }
}
