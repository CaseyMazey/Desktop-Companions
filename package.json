{
  "name": "pets",
  "productName": "Pets",
  "version": "0.2.0",
  "private": true,
  "description": "Pets - kleine Bildschirm-Begleiter, die sich mit NEXUS, DAN, Nook oder jeder anderen App verbinden",
  "desktopName": "pets.desktop",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "author": {
    "name": "CaseyMazey",
    "email": "253219934+CaseyMazey@users.noreply.github.com"
  },
  "homepage": "https://github.com/CaseyMazey/Pets",
  "build": {
    "appId": "io.github.caseymazey.pets",
    "productName": "Pets",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Pets-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Pets",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Pets-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "Pets-mac-${arch}-${version}.${ext}"
    },
    "dmg": {
      "title": "Pets",
      "artifactName": "Pets-mac-${arch}-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "pets",
      "synopsis": "Bildschirm-Pets für NEXUS, DAN und Nook",
      "description": "Pets – kleine Bildschirm-Begleiter, die immer im Vordergrund bleiben, erinnern, gratulieren und miteinander plaudern.",
      "artifactName": "Pets-linux-${arch}-${version}.${ext}",
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "pets-desktop",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64 | libasound2"
      ]
    }
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  }
}
